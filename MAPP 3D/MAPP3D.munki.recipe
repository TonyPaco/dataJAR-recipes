<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Description</key>
    <string>Downloads the latest version of MAPP 3D and imports it into Munki.

For Apple Silicon use "arm64" for both DOWNLOAD_ARCH and SUPPORTED_ARCH.
For Intel use "x86-64" for DOWNLOAD_ARCH and "x86_64" for SUPPORTED_ARCH.</string>
    <key>Identifier</key>
    <string>com.github.dataJAR-recipes.munki.MAPP3D</string>
    <key>Input</key>
    <dict>
        <key>NAME</key>
        <string>MAPP3D</string>
        <key>MUNKI_REPO_SUBDIR</key>
        <string>apps/%NAME%</string>
        <key>SUPPORTED_ARCH</key>
        <string>x86_64</string>
        <key>pkginfo</key>
        <dict>
            <key>blocking_applications</key>
            <array>
                <string>MAPP 3D.app</string>
            </array>
            <key>catalogs</key>
            <array>
                <string>testing</string>
            </array>
            <key>description</key>
            <string>MAPP 3D is a powerful audio prediction and system optimization tool from Meyer Sound for designing and tuning sound systems.</string>
            <key>developer</key>
            <string>Meyer Sound</string>
            <key>display_name</key>
            <string>MAPP 3D</string>
            <key>name</key>
            <string>%NAME%</string>
            <key>supported_architectures</key>
            <array>
                <string>%SUPPORTED_ARCH%</string>
            </array>
            <key>unattended_install</key>
            <true/>
            <key>unattended_uninstall</key>
            <true/>
        </dict>
    </dict>
    <key>MinimumVersion</key>
    <string>1.1</string>
    <key>ParentRecipe</key>
    <string>com.github.dataJAR-recipes.download.MAPP3D</string>
    <key>Process</key>
    <array>
        <dict>
            <key>Arguments</key>
            <dict>
                <key>pkg_path</key>
                <string>%pathname%</string>
                <key>repo_subdirectory</key>
                <string>%MUNKI_REPO_SUBDIR%</string>
            </dict>
            <key>Processor</key>
            <string>MunkiImporter</string>
        </dict>
    </array>
</dict>
</plist>

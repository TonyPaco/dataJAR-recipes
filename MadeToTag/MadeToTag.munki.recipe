<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Description</key>
    <string>Downloads and imports MadeToTag for Adobe InDesign %INDESIGN_YEAR% into Munki.</string>
    <key>Identifier</key>
    <string>com.github.dataJAR-recipes.munki.MadeToTag</string>
    <key>Input</key>
    <dict>
        <key>NAME</key>
        <string>MadeToTag%INDESIGN_YEAR%</string>
        <key>MUNKI_REPO_SUBDIR</key>
        <string>apps/%NAME%</string>
        <key>pkginfo</key>
        <dict>
            <key>catalogs</key>
            <array>
                <string>testing</string>
            </array>
            <key>description</key>
            <string>MadeToTag is an InDesign plugin for creating accessible, tagged PDF files.</string>
            <key>developer</key>
            <string>axaio software GmbH</string>
            <key>display_name</key>
            <string>MadeToTag %INDESIGN_YEAR%</string>
            <key>name</key>
            <string>%NAME%</string>
            <key>requires</key>
            <array>
                <string>AdobeInDesign%INDESIGN_YEAR%</string>
            </array>
            <key>unattended_install</key>
            <true/>
            <key>unattended_uninstall</key>
            <true/>
        </dict>
    </dict>
    <key>MinimumVersion</key>
    <string>2.3</string>
    <key>ParentRecipe</key>
    <string>com.github.dataJAR-recipes.download.MadeToTag</string>
    <key>Process</key>
    <array>
        <dict>
            <key>Arguments</key>
            <dict>
                <key>pkg_path</key>
                <string>%pathname%</string>
                <key>repo_subdirectory</key>
                <string>%MUNKI_REPO_SUBDIR%</string>
            </dict>
            <key>Processor</key>
            <string>MunkiImporter</string>
        </dict>
    </array>
</dict>
</plist>
